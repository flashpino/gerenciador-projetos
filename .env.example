# Copie para .env.local e preencha. NUNCA commite .env.local.
#
# AVISO DE SEGURANCA (manual, Fase 0.6):
# Tudo com prefixo VITE_ e embutido no bundle e fica VISIVEL para qualquer usuario.
# A anon key e feita para isso e e segura SOMENTE com Row Level Security ativo
# em todas as tabelas.
# A SUPABASE_SERVICE_ROLE_KEY NUNCA entra neste projeto, em nenhuma circunstancia.
# Ela ignora RLS por design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
