{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-manual-reminder.sh",
            "statusMessage": "Carregando protocolo do manual-vibecode-claude.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-manual-gate.sh",
            "statusMessage": "Checando checklist pré-commit do manual"
          }
        ]
      }
    ]
  }
}
